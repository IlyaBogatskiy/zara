# Copy to .env and fill in. The .env file is gitignored — secrets stay local.

# --- required: token from @BotFather ---
TELEGRAM_BOT_TOKEN=

# --- optional: operator chatId for technical alerts (0 = log only) ---
ZARA_ADMIN_CHAT_ID=0

# --- optional: Postgres credentials (defaults match local development) ---
POSTGRES_USER=zara
POSTGRES_PASSWORD=zara_pass
